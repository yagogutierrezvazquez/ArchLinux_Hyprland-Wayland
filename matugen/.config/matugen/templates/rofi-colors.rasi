/* Generated by matugen from ~/.config/matugen/templates/rofi-colors.rasi
   Do not edit the generated file, edit the template. */

* {
    /* Dark base tinted with the wallpaper's hue */
    bg:          {{colors.surface_container_lowest.default.hex}};
    surface:     {{colors.surface_container.default.hex}};
    fg:          {{colors.on_surface.default.hex}};
    fg-dim:      {{colors.outline.default.hex}};

    /* Fixed semantic colors */
    warning:     #f5a524;
    critical:    #ef4444;

    /* Accent: the wallpaper's own color at a readable lightness */
    accent:      <* if {{ mono }} *>{{mono_accent}}<* else *>{{colors.primary_container.default.hex | set_lightness: 65.0}}<* endif *>;
    on-accent:   {{colors.surface_container_lowest.default.hex}};
    accent-soft: <* if {{ mono }} *>{{mono_accent}}26<* else *>{{colors.primary_container.default.hex_alpha | set_lightness: 65.0 | set_alpha: 0.15}}<* endif *>;
    accent-line: <* if {{ mono }} *>{{mono_accent}}40<* else *>{{colors.primary_container.default.hex_alpha | set_lightness: 65.0 | set_alpha: 0.25}}<* endif *>;
}
