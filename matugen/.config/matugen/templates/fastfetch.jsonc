// ~/.config/fastfetch/config.jsonc: GENERATED by matugen from the wallpaper.
// Don't edit here: edit ~/.config/matugen/templates/fastfetch.jsonc
// Shown when a kitty window opens (~/.bashrc). The logo is the Arch logo as
// an LED dot matrix (~/.cache/fetch-logo.png, made by hypr/scripts/fetch-logo.py
// on every wallpaper change), drawn with kitty's graphics protocol.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.cache/fetch-logo.png",
        "width": 25,
        "height": 11,
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "<* if {{ mono }} *>{{mono_accent}}<* else *>{{colors.primary_container.default.hex | set_lightness: 65.0}}<* endif *>",
            "title": "<* if {{ mono }} *>{{mono_accent}}<* else *>{{colors.primary_container.default.hex | set_lightness: 65.0}}<* endif *>",
            "output": "{{colors.on_surface.default.hex}}",
            "separator": "{{colors.outline.default.hex}}"
        }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "custom", "format": "{#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}────────────────────────" },
        { "type": "os",       "key": "", "format": "{pretty-name}" },
        { "type": "kernel",   "key": "󰌽", "format": "{release}" },
        { "type": "wm",       "key": "", "format": "{pretty-name} {version}" },
        { "type": "packages", "key": "󰏖", "format": "{all} packages" },
        { "type": "command",  "key": "󰍛", "text": "grep -m1 'model name' /proc/cpuinfo | sed -E 's/.*: //; s/[(](R|TM)[)]//g; s/[0-9]+th Gen //'" },
        { "type": "memory",   "key": "󰘚", "format": "{used} / {total}" },
        { "type": "battery",  "key": "󰁹", "format": "{capacity}" },
        { "type": "uptime",   "key": "󰔟", "format": "{?days}{days}d {?}{hours}h {minutes}m" }
    ]
}
