pragma Singleton

// Shared colors for every Quickshell piece. Values come from colors.json
// (generated by matugen from the wallpaper) and reload live when it changes.
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    readonly property color bg: colors.bg
    readonly property color surface: colors.surface
    readonly property color fg: colors.fg
    readonly property color fgDim: colors.fgDim
    readonly property color accent: colors.accent
    readonly property color accentText: colors.accentText

    readonly property string font: "JetBrainsMono Nerd Font Propo"

    function withAlpha(c, a) {
        return Qt.rgba(c.r, c.g, c.b, a);
    }

    FileView {
        path: Quickshell.shellPath("colors.json")
        watchChanges: true
        onFileChanged: reload()

        JsonAdapter {
            id: colors
            property string bg: "#0a0a0a"
            property string surface: "#161616"
            property string fg: "#e6e6e6"
            property string fgDim: "#6e6e6e"
            property string accent: "#95cdf8"
            property string accentText: "#00344e"
        }
    }
}
