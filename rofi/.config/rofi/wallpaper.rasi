/* ~/.config/rofi/wallpaper.rasi
   Wallpaper picker: floating black panel at the bottom, horizontal strip of
   thumbnails, search bar underneath. Used by scripts/wallpaper.sh. */

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Propo SemiBold 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: south;
    anchor: south;
    y-offset: -24px;
    width: 80%;           /* fallback; wallpaper.sh sets the width per column count */
    padding: 18px;
    background-color: @bg;
    border: 1px solid;
    border-color: @accent-line;
    border-radius: 16px;
}

mainbox {
    children: [ listview, inputbar ];
    spacing: 16px;
}

/* One row of equal-width columns (a 1-line grid, filled left to right).
   wallpaper.sh sets columns = min(wallpapers, 4); more scroll page by page. */
listview {
    layout: vertical;
    flow: horizontal;
    lines: 1;
    columns: 4;
    fixed-height: true;
    spacing: 12px;
    scrollbar: false;
    cycle: true;
}

element {
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    border-radius: 12px;
    cursor: pointer;
}

element selected.normal {
    background-color: @accent-soft;
}

element-icon {
    size: 220px;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    text-color: @fg-dim;
    cursor: inherit;
}

element selected.normal element-text {
    text-color: @accent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 10px 14px;
    background-color: @surface;
    border-radius: 10px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search wallpapers…";
    placeholder-color: @fg-dim;
    cursor: text;
}
