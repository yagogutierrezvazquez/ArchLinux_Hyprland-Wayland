/* ~/.config/rofi/launcher.rasi
   App launcher (SUPER+R): black panel rising from the bottom of the screen.
   Each row = icon + name + dim description; search bar at the bottom.
   Apps you open most float to the top (rofi's drun history). */

configuration {
    show-icons: true;
    icon-theme: "breeze-dark";
    /* comment must be a match field to be shown; it also makes descriptions searchable */
    drun-match-fields: "name,generic,comment,exec,categories,keywords";
    drun-display-format: "{name}\n[<span size='small' alpha='55%'>{comment}</span>]";
    display-drun: "";   /* fa-search */
}

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Propo SemiBold 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: south;
    anchor: south;
    y-offset: -24px;
    width: 620px;
    padding: 14px;
    background-color: @bg;
    border: 1px solid;
    border-color: @accent-line;
    border-radius: 18px;
}

mainbox {
    children: [ listview, inputbar ];
    spacing: 12px;
}

listview {
    lines: 7;
    fixed-height: false;   /* shrink to the number of results (window stays anchored at the bottom) */
    scrollbar: false;
    spacing: 4px;
    cycle: true;
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    padding: 10px 12px;
    spacing: 14px;
    border-radius: 12px;
    cursor: pointer;
}

element selected.normal {
    background-color: @accent-soft;
}

element-icon {
    size: 34px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    markup: true;
    cursor: inherit;
}

element selected.normal element-text {
    text-color: @accent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 12px 16px;
    background-color: @surface;
    border-radius: 12px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search apps…";
    placeholder-color: @fg-dim;
    cursor: text;
}
