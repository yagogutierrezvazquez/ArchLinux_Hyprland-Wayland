/* ~/.config/rofi/menu.rasi
   Compact list menu for bar popups (Wi-Fi, later power etc.):
   black panel at the top-right under Waybar, accent highlight. */

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Propo SemiBold 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: north east;
    anchor: north east;
    x-offset: -10px;
    y-offset: 8px;
    width: 340px;
    padding: 12px;
    background-color: @bg;
    border: 1px solid;
    border-color: @accent-line;
    border-radius: 14px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 8px 12px;
    background-color: @surface;
    border-radius: 10px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search…";
    placeholder-color: @fg-dim;
    cursor: text;
}

message {
    padding: 0 4px;
}

textbox {
    text-color: @fg-dim;
}

listview {
    lines: 8;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 8px 10px;
    border-radius: 8px;
    cursor: pointer;
}

element selected.normal {
    background-color: @accent-soft;
}

element-text {
    cursor: inherit;
}

element selected.normal element-text {
    text-color: @accent;
}
